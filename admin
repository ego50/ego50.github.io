<!DOCTYPE html>
<html lang="fr">
<head>
  <link rel="stylesheet" href="style.css">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Espace Admin</title>
</head>
<body>
  <header>
    <h1>Mon classeur numérique</h1>
    <nav>
      <a href="index.html">Accueil</a>
      <a href="cours.html">Cours</a>
      <a href="tp.html">Mes TP</a>
      <a href="projets.html">Projets</a>
      <a href="admin.html">Admin</a>
    </nav>
  </header>

  <main>
    <!-- Formulaire de connexion -->
    <div id="connexion">
      <h2>Espace réservé</h2>
      <p>Merci d'entrer le mot de passe pour accéder à cette page.</p>
      <input type="password" id="mot-de-passe" placeholder="Mot de passe">
      <button id="btn-connexion">Valider</button>
      <p id="erreur" style="color: #ff4444; display: none;">Mot de passe incorrect.</p>
    </div>

    <!-- Contenu caché, visible seulement après le bon mot de passe -->
    <div id="contenu-admin" style="display: none;">
      <h2>Bienvenue, Professeur</h2>
      <p>Voici l'espace réservé à l'évaluation de mon site.</p>
      <p>Vous pouvez consulter l'ensemble de mes pages via le menu de navigation.</p>
    </div>
  </main>

  <script>
    const MOT_DE_PASSE = "prof2024"; // change ça par le mot de passe que tu veux

    document.getElementById('btn-connexion').addEventListener('click', verifierMotDePasse);
    document.getElementById('mot-de-passe').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') verifierMotDePasse();
    });

    function verifierMotDePasse() {
      const saisie = document.getElementById('mot-de-passe').value;
      if (saisie === MOT_DE_PASSE) {
        document.getElementById('connexion').style.display = 'none';
        document.getElementById('contenu-admin').style.display = 'block';
      } else {
        document.getElementById('erreur').style.display = 'block';
      }
    }
  </script>
</body>
</html>
